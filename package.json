  "dependencies": {
    "@vueuse/core": "^14.3.0",
    "axios": "^1.17.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.4",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@iconify/json": "^2.2.482",
    "@types/node": "^25.9.1",
    "@unocss/eslint-plugin": "^66.7.0",
    "@unocss/transformer-directives": "^66.7.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.4.1",
    "eslint-plugin-format": "^2.0.1",
    "jsdom": "^29.1.1",
    "nano-staged": "^1.0.2",
    "simple-git-hooks": "^2.13.1",
    "taze": "^19.14.1",
    "typescript": "^6.0.3",
    "unocss": "^66.7.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3"
  },
  "resolutions": {
    "unplugin": "^3.0.0",
